# NODE_ENV=development — wird nach `.env` geladen (siehe .env.example).

# Kopieren nach `.env.development` und anpassen.

#

# Datenbank: SQLite-Dateien (Standard für npm run dev). API-Schlüssel: optional — siehe .env.example.

# Angular/Dev-Proxy: PUBLIC_API_BASE_URL wie unten zum laufenden Backend (meist PORT 3000).



DATABASE_URL="file:./dev.db"

CACHE_DATABASE_URL="file:./cache.db"

JSON_STORAGE_DATABASE_URL="file:./json-storage.db"

PUBLIC_API_BASE_URL=http://localhost:3000

