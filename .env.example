# Kopiere nach `.env` und trage Geheimnisse nur dort ein (`.env` ist ignoriert).

# --- Node (optional, lokal)
# NODE_ENV=development

# --- Prisma / Store (Schema: store/prisma/schema.prisma)
# SQLite relativ zum Prisma-Schema; bei `npm run prisma:sync` aus dem Repo-Root ausführen.
DATABASE_URL="file:./dev.db"
# Optional: detaillierte Prisma-Logs in der Konsole
# DEBUG=prisma:query

# --- Anthropic Claude (nur öffentliche Defaults hier; API-Key ausschließlich in `.env`)
# CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# --- Philips Hue (jsonAggregator) — Werte wie in HuePlayground Backend hueHandler (IP + API-Username)
HUE_BRIDGE_HOST=192.168.0.99
HUE_BRIDGE_USER=

# Pause in ms nach jedem fertigen Hue-Befehl (Director-Queue), gegen Brücken-Rate-Limit (429)
HUE_INTER_COMMAND_DELAY_MS=120

# --- OpenRouteService (Bloodhound) — Keys kommagetrennt; nur in `.env` setzen, nicht committen
# ORS_API_KEYS=

# --- Overpass API (OpenStreetMap) — empfohlen für die öffentliche Instanz
OVERPASS_USER_AGENT=jsonAggregator/dev (setze eine Kontakt-URL oder E-Mail in `.env`)
