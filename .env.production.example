# NODE_ENV=production — siehe .env.example.
# Kopieren nach `.env.production`; Secrets nur auf dem Server / in `.env.production.local`.
#
# Datenbank: Cloud-/Server-URLs. API-Keys optional — siehe .env.example.
#
# Öffentliche API-Basis für den Angular-Build (npm run ui:build lädt diese Datei):
# — leer lassen, wenn SPA und API dieselbe Origin haben (Standard hinter Reverse-Proxy)
# — oder z. B. https://api.example.com wenn die API eine eigene Domain hat
#
# PUBLIC_API_BASE_URL=
# PORT=3000

# WICHTIG: Teilen sich zwei URLs dieselbe physische Postgres-DB, muessen sie auf
# unterschiedliche Postgres-Schemas zeigen (?schema=...) — sonst droppt
# `prisma db push --accept-data-loss` die Tabellen des jeweils anderen Clients.
# dbEnv.cjs erzwingt diese Regel beim Start.
#
# Variante A — drei getrennte Datenbanken:
# DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/storeDb?sslmode=require"
# CACHE_DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/cacheDb?sslmode=require"
# JSON_STORAGE_DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/jsonDb?sslmode=require"
#
# Variante B — nur zwei DBs, Cache + JSON-Storage teilen sich eine via Schemas:
# DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/storeDb?sslmode=require"
# CACHE_DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/sharedDb?sslmode=require&schema=cache"
# JSON_STORAGE_DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/sharedDb?sslmode=require&schema=json_storage"
