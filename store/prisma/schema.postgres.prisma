// PostgreSQL — für NODE_ENV production | integration (npm run prisma:sync:integration / :prod).
// Entwicklung: store/prisma/schema.prisma (SQLite).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dog {
  id                   String   @id
  lineageId            String?
  parentId             String?
  displayName          String?
  type                 String
  serializedDogConfig   String?
  name                 String?
  description          String?
  dogIds               String?
  defaultQuery         String?
  defaultBody          String?
  emoji                String?
  task                 String?
  nodes                String?
  edges                String?
  visibility           String?  // "public" | "private". Null bei Nicht-Kennel-Dogs.
  // NOTE: vmTimeoutMs ist KEIN Persistenz-Feld -- gehoert per-run-call mitgegeben (Welle 12 Korrektur).
  ownerId              String?  // FK auf User.id. Null = community-editable (legacy / system-owned).
  editors              String?  // Comma-separated User.id list — additional editors.
  viewers              String?  // Comma-separated User.id list — additional viewers (private only).
  createdAt            DateTime? @default(now())
  updatedAt            DateTime?
}

// ---------------------------------------------------------------------------
// Postgres-Single-DB-Mode: alle Tabellen liegen in derselben physischen DB.
// Cache-, JSON-Storage- UND Auth-Schemas (store/prisma-cache,
// store/prisma-json-storage, store/prisma-auth) erzeugen eigene typisierte
// Clients, werden aber NICHT mehr separat gepusht (siehe run-prisma-sync.cjs).
// Das hier ist die einzige Wahrheit fuer die DB-Struktur in Postgres-Mode.
// Definitionen muessen 1:1 mit den jeweiligen Cache-/JSON-/Auth-Schemas
// uebereinstimmen.
//
// Auth liegt hier mit, weil ein eigenes Postgres-Schema CREATE-Recht auf der
// Datenbank braeuchte (gehostete Postgres/dbaas verweigert das oft) und zwei
// getrennte `db push` in dieselbe DB sich gegenseitig Tabellen droppen wuerden.
// Wer eine bewusst getrennte Auth-DB betreibt (eigener host/db mit vollen
// Rechten), setzt AUTH_DATABASE_URL dorthin — dann wird Auth wieder separat
// gepusht (dbEnv.authSharesStoreDatabase() == false). Dev (SQLite) bleibt eh
// getrennt (store/prisma-auth/schema.prisma, eigene auth.db).
// ---------------------------------------------------------------------------

model CacheEntry {
  key       String @id
  value     String
  expiresAt BigInt
}

model GeoAreaCache {
  id           String @id @default(cuid())
  discriminant String
  centerLat    Float
  centerLng    Float
  radiusM      Float
  bboxMinLat   Float
  bboxMinLng   Float
  bboxMaxLat   Float
  bboxMaxLng   Float
  cacheKey     String
  payload      String
  cachedAt     BigInt
  expiresAt    BigInt

  @@index([discriminant, expiresAt])
  @@index([discriminant, bboxMinLat, bboxMaxLat, bboxMinLng, bboxMaxLng])
}

model JsonEntry {
  key       String @id
  value     String
  updatedAt BigInt
}

model GeoFeature {
  dogType      String
  osmType      String
  osmId        BigInt
  primaryKey   String?
  primaryValue String?
  name         String?
  hasGeom      Boolean
  lat          Float?
  lng          Float?
  bboxMinLat   Float?
  bboxMinLng   Float?
  bboxMaxLat   Float?
  bboxMaxLng   Float?
  payload      String
  updatedAt    BigInt

  @@id([dogType, osmType, osmId])
  @@index([dogType, primaryKey, primaryValue])
  @@index([dogType, bboxMinLat, bboxMaxLat])
}

model FeatureTileMembership {
  dogType String
  osmType String
  osmId   BigInt
  zoom    Int
  tileX   Int
  tileY   Int
  facet   String

  @@id([dogType, osmType, osmId, zoom, tileX, tileY, facet])
  @@index([dogType, zoom, tileX, tileY, facet])
}

model TileCoverage {
  dogType   String
  zoom      Int
  tileX     Int
  tileY     Int
  facet     String
  fetchedAt BigInt
  expiresAt BigInt

  @@id([dogType, zoom, tileX, tileY, facet])
  @@index([expiresAt])
  @@index([dogType, zoom, tileX, tileY])
}

// ---------------------------------------------------------------------------
// Auth / OAuth — 1:1 mit store/prisma-auth/schema.postgres.prisma.
// In Postgres-Single-DB (Auth teilt die Store-DB) liegen diese Tabellen hier in
// `public` und werden vom Store-Push angelegt; der prisma-auth-Client wird nur
// generiert (kein eigener Push). Aenderungen hier UND in store/prisma-auth
// gleich halten. Getrennte Auth-DB: siehe run-prisma-sync.cjs / dbEnv.cjs.
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  googleSub String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthClient {
  id           String   @id @default(uuid())
  clientId     String   @unique
  clientSecret String?
  name         String
  redirectUris String
  createdAt    DateTime @default(now())
}

model AuthorizationCode {
  code                String   @id
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String?
  codeChallengeMethod String?
  scope               String
  expiresAt           DateTime
  createdAt           DateTime @default(now())
}

model AccessToken {
  jti       String    @id
  userId    String
  clientId  String
  scope     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model RefreshToken {
  token     String    @id
  userId    String
  clientId  String
  scope     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}
