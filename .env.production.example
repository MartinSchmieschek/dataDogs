# NODE_ENV=production — siehe .env.example.
# Kopieren nach `.env.production`; Secrets nur auf dem Server / in `.env.production.local`.
#
# Datenbank: Cloud-/Server-URLs. API-Keys optional — siehe .env.example.
#
# Öffentliche API-Basis für den Angular-Build (npm run ui:build lädt diese Datei):
# — leer lassen, wenn SPA und API dieselbe Origin haben (Standard hinter Reverse-Proxy)
# — oder z. B. https://api.example.com wenn die API eine eigene Domain hat
#
# PUBLIC_API_BASE_URL=
# PORT=3000

# Postgres Single-DB-Mode: Nur DATABASE_URL setzen — CACHE_DATABASE_URL und
# JSON_STORAGE_DATABASE_URL werden von dbEnv.cjs auf denselben Wert gespiegelt.
# Alle Tabellen liegen in `public` derselben DB; nur das Haupt-Schema
# (store/prisma/schema.postgres.prisma) wird gepusht.
#
# DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/DATENBANK?sslmode=require"
#
# Wenn du explizit getrennte DBs/Namespaces willst, setze die anderen URLs
# zusaetzlich — sie muessen sich dann in (host, db, schema) unterscheiden.
