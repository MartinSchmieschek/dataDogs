# NODE_ENV=integration — Staging / CI (siehe .env.example).
# Kopieren nach `.env.integration` (gitignored); echte Zugangsdaten nur dort, nicht committen.
#
# -----------------------------------------------------------------------------
# Öffentliche Basis-URL (Links im UI: Swagger, window.open, apiAbsoluteUrl)
# -----------------------------------------------------------------------------
# SPA und API unter EINER Origin (typisch Render: eine Web-URL, Express liefert / + /api):
#   PUBLIC_API_BASE_URL nicht setzen ODER explizit leer: PUBLIC_API_BASE_URL=
#   → Build injiziert Same-Origin; im Browser gilt window.location.origin (z. B. https://dein-service.onrender.com).
#
# Getrennte API-Domain oder lokaler Test gegen Remote-API:
#   PUBLIC_API_BASE_URL=https://staging-api.example.com
#
# Render-Dashboard: NICHT PUBLIC_API_BASE_URL=http://localhost:3000 setzen (wirkt ins gebaute UI);
# weglassen oder echte https://…-URL. Code verwirft localhost in integration/prod zusätzlich.
#
# Logs: Standard ruhig (keine großen Objekte). Für Diagnose: DATADOGS_LOG_LEVEL=verbose
#
# CORS: SPA + API unter derselben Host-URL (Render) → nichts setzen; Server erlaubt Origin = Request-Host.
# Getrenntes UI (z. B. ng serve :4300, API :3000): CORS_ORIGIN=http://localhost:4300 oder CORS_ALLOWED_ORIGINS=…
#
# Store (Prisma store/prisma)
# DATABASE_URL="postgresql://BENUTZER:PASSWORT@STORE-HOST:PORT/DATENBANK?sslmode=require"
#
# Cache (Prisma store/prisma-cache)
# CACHE_DATABASE_URL="postgresql://BENUTZER:PASSWORT@CACHE-HOST:PORT/DATENBANK?sslmode=require"
#
# JSON-Storage (Prisma store/prisma-json-storage) — fachliche KV-Ablage fuer jsonStore (VM-Global-Capability)
# JSON_STORAGE_DATABASE_URL="postgresql://BENUTZER:PASSWORT@JSON-HOST:PORT/DATENBANK?sslmode=require"
#
# -----------------------------------------------------------------------------
# Overpass (TrailRetriever & Co.)
# -----------------------------------------------------------------------------
# Der oeffentliche Endpoint https://overpass-api.de/api/interpreter ist unter
# Last oft langsam und kippt bei Ueberlast mit HTTP 200 + HTML-Error. Auf der
# INT explizit auf einen Mirror zeigen; TrailRetriever nutzt zusaetzlich eine
# Fallback-Chain (lz4 -> kumi -> public) wenn der primaere Endpoint fehlschlaegt.
#
# OVERPASS_URL=https://lz4.overpass-api.de/api/interpreter
# OVERPASS_QUERY_TIMEOUT_SEC=120
# OVERPASS_FETCH_TIMEOUT_MS=180000
# OVERPASS_USER_AGENT=jsonAggregator/int (Kontakt anpassen)

# -----------------------------------------------------------------------------
# Socket-Lobby (WebSocketChannelRetriever / ChannelHub)
# -----------------------------------------------------------------------------
# WS-Pfad an dem der Hub Upgrade-Requests annimmt (Default: /api/channels)
# WS_PATH=/api/channels
# Empfohlenes Heartbeat-Intervall in Sekunden (Default: 20)
# WS_HEARTBEAT_SEC=20
# Empty-Room-TTL: leere Channels werden nach so vielen Sekunden entsorgt (Default: 300)
# WS_EMPTY_TTL_SEC=300
# Max. Bytes pro WS-Nachricht (Default: 16384)
# WS_MAX_MESSAGE_BYTES=16384
# Max. Peers pro Channel (Default: 50)
# WS_MAX_PEERS_PER_CHANNEL=50
