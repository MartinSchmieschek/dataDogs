# NODE_ENV=development — loaded after `.env` (see .env.example).
#
# Copy to `.env.development` and adjust.
#
# Database: SQLite files (default for `npm run dev`). API keys: optional — see .env.example.
#
# Angular / dev proxy: set PUBLIC_API_BASE_URL to match the running backend (usually port 3000).



DATABASE_URL="file:./dev.db"

CACHE_DATABASE_URL="file:./cache.db"

JSON_STORAGE_DATABASE_URL="file:./json-storage.db"

PUBLIC_API_BASE_URL=http://localhost:3000
