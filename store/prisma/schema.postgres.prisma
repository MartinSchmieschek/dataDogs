// PostgreSQL — für NODE_ENV production | integration (npm run prisma:sync:integration / :prod).
// Entwicklung: store/prisma/schema.prisma (SQLite).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dog {
  id                   String   @id
  lineageId            String?
  parentId             String?
  displayName          String?
  type                 String
  serializedDogConfig   String?
  name                 String?
  description          String?
  dogIds               String?
  defaultQuery         String?
  defaultBody          String?
  emoji                String?
  createdAt            DateTime? @default(now())
  updatedAt            DateTime?
}

// ---------------------------------------------------------------------------
// Postgres-Single-DB-Mode: alle Tabellen liegen in derselben physischen DB.
// Cache- und JSON-Storage-Schemas (store/prisma-cache, store/prisma-json-storage)
// erzeugen eigene typisierte Clients, werden aber NICHT mehr gepusht
// (siehe scripts/run-prisma-sync.cjs). Das hier ist die einzige Wahrheit
// fuer die DB-Struktur in Postgres-Mode. Definitionen muessen 1:1 mit den
// jeweiligen Cache-/JSON-Schemas uebereinstimmen.
// ---------------------------------------------------------------------------

model CacheEntry {
  key       String @id
  value     String
  expiresAt BigInt
}

model GeoAreaCache {
  id           String @id @default(cuid())
  discriminant String
  centerLat    Float
  centerLng    Float
  radiusM      Float
  bboxMinLat   Float
  bboxMinLng   Float
  bboxMaxLat   Float
  bboxMaxLng   Float
  cacheKey     String
  payload      String
  cachedAt     BigInt
  expiresAt    BigInt

  @@index([discriminant, expiresAt])
  @@index([discriminant, bboxMinLat, bboxMaxLat, bboxMinLng, bboxMaxLng])
}

model JsonEntry {
  key       String @id
  value     String
  updatedAt BigInt
}

model GeoFeature {
  dogType      String
  osmType      String
  osmId        BigInt
  primaryKey   String?
  primaryValue String?
  name         String?
  hasGeom      Boolean
  lat          Float?
  lng          Float?
  bboxMinLat   Float?
  bboxMinLng   Float?
  bboxMaxLat   Float?
  bboxMaxLng   Float?
  payload      String
  updatedAt    BigInt

  @@id([dogType, osmType, osmId])
  @@index([dogType, primaryKey, primaryValue])
  @@index([dogType, bboxMinLat, bboxMaxLat])
}

model FeatureTileMembership {
  dogType String
  osmType String
  osmId   BigInt
  zoom    Int
  tileX   Int
  tileY   Int
  facet   String

  @@id([dogType, osmType, osmId, zoom, tileX, tileY, facet])
  @@index([dogType, zoom, tileX, tileY, facet])
}

model TileCoverage {
  dogType   String
  zoom      Int
  tileX     Int
  tileY     Int
  facet     String
  fetchedAt BigInt
  expiresAt BigInt

  @@id([dogType, zoom, tileX, tileY, facet])
  @@index([expiresAt])
  @@index([dogType, zoom, tileX, tileY])
}
