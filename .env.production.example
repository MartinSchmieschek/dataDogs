# NODE_ENV=production — see .env.example.
# Copy to `.env.production`; keep secrets on the server / in `.env.production.local`.
#
# Database: use cloud/server URLs. API keys optional — see .env.example.
#
# Public API base for the Angular build (`npm run ui:build` reads this file):
# — leave empty if SPA and API share the same origin (typical behind a reverse proxy)
# — or e.g. https://api.example.com if the API has its own host
#
# PUBLIC_API_BASE_URL=
# PORT=3000
#
# Postgres single-DB mode: set only DATABASE_URL — CACHE_DATABASE_URL and
# JSON_STORAGE_DATABASE_URL are mirrored to the same value in dbEnv.cjs.
# All tables live in `public` in that DB; only the main store schema
# (store/prisma/schema.postgres.prisma) is pushed.
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
#
# If you explicitly need separate DBs or namespaces, set the other URLs too;
# they must then differ in (host, database, schema).
