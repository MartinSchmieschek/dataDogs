// PostgreSQL — für NODE_ENV production | integration.
// Entwicklung: store/prisma-cache/schema.prisma (SQLite).
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-cache-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CACHE_DATABASE_URL")
}

model CacheEntry {
  key       String @id
  value     String
  expiresAt BigInt
}

// Persistenter Geo-Area-Cache (siehe schema.prisma fuer Details).
model GeoAreaCache {
  id           String @id @default(cuid())
  discriminant String
  centerLat    Float
  centerLng    Float
  radiusM      Float
  bboxMinLat   Float
  bboxMinLng   Float
  bboxMaxLat   Float
  bboxMaxLng   Float
  cacheKey     String
  payload      String
  cachedAt     BigInt
  expiresAt    BigInt

  @@index([discriminant, expiresAt])
  @@index([discriminant, bboxMinLat, bboxMaxLat, bboxMinLng, bboxMaxLng])
}
