// KennelRun-HTTP-Cache — SQLite für lokale Entwicklung. PostgreSQL: schema.postgres.prisma.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-cache-client"
}

datasource db {
  provider = "sqlite"
  url      = env("CACHE_DATABASE_URL")
}

model CacheEntry {
  key       String @id
  value     String
  // Unix-Zeit in ms — Prisma BigInt
  expiresAt BigInt
}

// Persistenter Geo-Area-Cache: speichert Circles (center+radius) mit vorberechneter
// Bounding-Box fuer schnelle Containment-Vorfilterung. Pro Discriminant (= Layer + Params)
// eine Partition, damit Queries fuer z.B. "food:cuisine=italian" nicht mit "food" kollidieren.
model GeoAreaCache {
  id           String @id @default(cuid())
  discriminant String
  centerLat    Float
  centerLng    Float
  radiusM      Float
  bboxMinLat   Float
  bboxMinLng   Float
  bboxMaxLat   Float
  bboxMaxLng   Float
  cacheKey     String
  payload      String
  cachedAt     BigInt
  expiresAt    BigInt

  @@index([discriminant, expiresAt])
  @@index([discriminant, bboxMinLat, bboxMaxLat, bboxMinLng, bboxMaxLng])
}
