// PostgreSQL — für NODE_ENV production | integration (npm run prisma:sync:integration / :prod).
// Entwicklung: store/prisma/schema.prisma (SQLite).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dog {
  id                   String   @id
  lineageId            String?
  parentId             String?
  displayName          String?
  type                 String
  serializedDogConfig   String?
  name                 String?
  description          String?
  dogIds               String?
  defaultQuery         String?
  defaultBody          String?
  emoji                String?
  visibility           String?  // "public" | "private". Null bei Nicht-Kennel-Dogs.
  ownerId              String?  // FK auf User.id. Null = community-editable (legacy / system-owned).
  editors              String?  // Comma-separated User.id list — additional editors.
  viewers              String?  // Comma-separated User.id list — additional viewers (private only).
  createdAt            DateTime? @default(now())
  updatedAt            DateTime?
}

// Auth + OAuth tables live in store/prisma-auth/ (separate DB: AUTH_DATABASE_URL).
