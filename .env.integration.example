# NODE_ENV=integration — staging / CI (see .env.example).
# Copy to `.env.integration` (gitignored); put real credentials there only, never commit.
#
# -----------------------------------------------------------------------------
# Public base URL (UI links: Swagger, window.open, apiAbsoluteUrl)
# -----------------------------------------------------------------------------
# SPA and API on ONE origin (typical Render: one URL, Express serves / and /api):
#   do not set PUBLIC_API_BASE_URL OR set it explicitly empty: PUBLIC_API_BASE_URL=
#   → the build uses same-origin; in the browser that is window.location.origin
#     (e.g. https://your-service.onrender.com).
#
# Split API host or local UI against a remote API:
#   PUBLIC_API_BASE_URL=https://staging-api.example.com
#
# Render dashboard: do NOT set PUBLIC_API_BASE_URL=http://localhost:3000 (bakes into the
# build); omit it or use a real https:// URL. Code also strips localhost in
# integration/prod.
#
# Logs: quiet by default. For diagnosis: DATADOGS_LOG_LEVEL=verbose
#
# CORS: if SPA and API share the same host (Render) — nothing to set; server allows
# the request’s origin. Split UI (e.g. ng serve :4300, API :3000): CORS_ORIGIN=http://localhost:4300
# or CORS_ALLOWED_ORIGINS=…
#
# -----------------------------------------------------------------------------
# Databases — required: PostgreSQL (no SQLite)
# -----------------------------------------------------------------------------
# Integration must NOT use file:./dev.db. DATABASE_URL must be postgresql://…
# or startup fails with DbEnvError.
#
# Single-DB mode: set only DATABASE_URL. Without ?schema= Postgres uses the default
# schema `public` — recommended for integration (no extra schemas).
# Omit CACHE_DATABASE_URL / JSON_STORAGE_DATABASE_URL; dbEnv.cjs mirrors them to
# the same URL. All tables (Dog, CacheEntry, GeoAreaCache, JsonEntry) come from
# one `prisma db push` (store/prisma/schema.postgres.prisma).
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
#
# Only if you need a non-`public` schema on purpose:
#   …?sslmode=require&schema=my_schema
#
# -----------------------------------------------------------------------------
# Overpass (TrailRetriever, etc.)
# -----------------------------------------------------------------------------
# The public https://overpass-api.de/api/interpreter is often slow and under load
# may return HTTP 200 with an HTML error page. Point INT at a mirror explicitly;
# TrailRetriever also has a fallback chain (lz4 -> kumi -> public) if the
# primary endpoint fails.
#
# OVERPASS_URL=https://lz4.overpass-api.de/api/interpreter
# OVERPASS_QUERY_TIMEOUT_SEC=120
# OVERPASS_FETCH_TIMEOUT_MS=180000
# OVERPASS_USER_AGENT=jsonAggregator/int (set a contact)
#
# -----------------------------------------------------------------------------
# Socket lobby (WebSocketChannelRetriever / ChannelHub)
# -----------------------------------------------------------------------------
# Path on which the hub accepts upgrade requests (default: /api/channels)
# WS_PATH=/api/channels
# Heartbeat interval in seconds (default: 20)
# WS_HEARTBEAT_SEC=20
# Empty-room TTL: evict empty channels after this many seconds (default: 300)
# WS_EMPTY_TTL_SEC=300
# Max bytes per WS message (default: 16384)
# WS_MAX_MESSAGE_BYTES=16384
# Max peers per channel (default: 50)
# WS_MAX_PEERS_PER_CHANNEL=50
