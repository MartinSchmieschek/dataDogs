# Kopiere nach `.env` und trage Geheimnisse nur dort ein (`.env` ist ignoriert).

# --- Node (optional, lokal)
# NODE_ENV=development

# --- CORS (Browser cross-origin → API :3000)
# Komma-getrennte erlaubte Origins (überschreibt Dev/Prod-Defaults). Z. B. mehrere Angular-Apps:
# CORS_ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4200,https://meine-app.example
# Ohne CORS_ALLOWED_ORIGINS: Dev = jede localhost/127.0.0.1-Origin; Prod = nur CORS_ORIGIN bzw. DEV_UI_ORIGIN
# DEV_UI_ORIGIN=http://localhost:4300
# CORS_ORIGIN=https://deployed-frontend.example

# --- Prisma / Store (Schema: store/prisma/schema.prisma)
# SQLite relativ zum Prisma-Schema; bei `npm run prisma:sync` aus dem Repo-Root ausführen.
DATABASE_URL="file:./dev.db"

# Optional: detaillierte Prisma-Logs in der Konsole
# DEBUG=prisma:query

# --- Cache (Prisma, eigenes Schema store/prisma-cache — eigene SQLite-Datei, nicht der Node/Kennel-Store)
# `npm run prisma:sync` legt Tabellen an (CACHE_DATABASE_URL im Env für generate/push).
# CACHE_DATABASE_URL hat Vorrang; sonst CACHE_DB_PATH als reiner Pfad → wird zu file:…
# CACHE_DATABASE_URL="file:./cache.db"
# CACHE_DB_PATH=./cache.db

# --- Anthropic Claude (nur öffentliche Defaults hier; API-Key ausschließlich in `.env`)
# CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# --- Philips Hue (jsonAggregator) — Werte wie in HuePlayground Backend hueHandler (IP + API-Username)
HUE_BRIDGE_HOST=192.168.0.99
HUE_BRIDGE_USER=

# Pause in ms nach jedem fertigen Hue-Befehl (Director-Queue), gegen Brücken-Rate-Limit (429)
HUE_INTER_COMMAND_DELAY_MS=120

# --- OpenRouteService (Bloodhound) — Keys kommagetrennt; nur in `.env` setzen, nicht committen
# Kostenloser Key: https://openrouteservice.org/dev/#/signup
# ORS_API_KEYS=

# --- Overpass API (OpenStreetMap) — empfohlen für die öffentliche Instanz
OVERPASS_USER_AGENT=jsonAggregator/dev (setze eine Kontakt-URL oder E-Mail in `.env`)
# Server-Timeout in der Overpass-Query `[timeout:N]` Sekunden (Default 120)
# OVERPASS_QUERY_TIMEOUT_SEC=120
# HTTP-Client-Abort in ms — sollte > Query-Timeout liegen (Default: Query + 60s)
# OVERPASS_FETCH_TIMEOUT_MS=180000

# --- Windy Webcams (WebcamRetriever) — Key unter https://api.windy.com/keys
# WINDY_API_KEY=

# --- eBird / Cornell Lab (BirdRetriever) — Key unter https://ebird.org/api/keygen
# EBIRD_API_KEY=
