# =============================================================================
#  dataDogs — environment variables (.env)
# =============================================================================
#
#  Which .env files are loaded is controlled by NODE_ENV (set by the npm scripts):
#
#    npm run dev | npm start          →  NODE_ENV=development  →  e.g. .env.development
#    npm run start:prod | npm run prod   →  NODE_ENV=production   →  e.g. .env.production
#    npm run start:integration | npm run integration  →  NODE_ENV=integration  →  e.g. .env.integration
#
#  Load order: .env → .env.local → .env.<NODE_ENV> → .env.<NODE_ENV>.local
#  (see scripts/load-env.cjs)
#
#  This file is the template. Copy to `.env` and fill in real values on your machine.
#  `.env` is not committed (see .gitignore).
#
#  Note: All API keys and tokens for external services (Claude, Hue, ORS, …) are
#  optional for dataDogs — the app starts without them; missing keys only disable
#  the corresponding integrations.
#
# -----------------------------------------------------------------------------
#  Layered loading (scripts/load-env.cjs)
# -----------------------------------------------------------------------------
#
#  Files are applied in order (later files override earlier keys):
#
#    .env
#    .env.local                    ← local, gitignored
#    .env.<NODE_ENV>               e.g. .env.development, .env.production, .env.integration
#    .env.<NODE_ENV>.local         ← per-environment secrets, gitignored
#
#  NODE_ENV is set by the npm scripts (development | production | integration).
#
#  More templates: `.env.development.example`, `.env.production.example`,
#  `.env.integration.example`
#
# =============================================================================
#  Databases (required — without DATABASE_URL + cache + JSON storage the app will not start)
# =============================================================================
#
#  Prisma: three clients — main store, cache (HTTP/geo), JSON storage (JsonStorageRetriever).
#    • Development (NODE_ENV=development): SQLite — schema in schema.prisma / cache / json-storage
#    • Integration/Production: PostgreSQL — *.postgres.prisma (npm run prisma:sync:integration / :prod)
#
#    • DATABASE_URL               → Haupt-Store
#    • CACHE_DATABASE_URL         → HTTP-Cache (oder CACHE_DB_PATH für reine Pfadangabe)
#    • JSON_STORAGE_DATABASE_URL  → Fachliche JSON-Ablage für jsonStore (VM-Global-Capability)
#                                   (oder JSON_STORAGE_DB_PATH für reine Pfadangabe)
#
#  PostgreSQL (integration/production): a single shared schema.postgres.prisma creates
#  all tables; you only set DATABASE_URL (cache/JSON mirror via dbEnv). Default schema is
#  `public`. See `.env.integration.example` for host-only mode.
#
#  Local dev (default): three SQLite files (db push creates them on first sync).
#
DATABASE_URL="file:./dev.db"
CACHE_DATABASE_URL="file:./cache.db"
JSON_STORAGE_DATABASE_URL="file:./json-storage.db"
# Auth-DB (User, OAuth-Clients, Tokens) — bewusst getrennt von DATABASE_URL,
# damit Auth-Daten und Content-Daten unabhängige Backups, Lifecycles und
# Connection-Pools haben. Schema: store/prisma-auth/schema.prisma
AUTH_DATABASE_URL="file:./auth.db"
# Auf Render: andere Postgres-DB als DATABASE_URL — z. B. eine zweite Datenbank
# auf derselben Instance reicht. Connection-Limit empfohlen, falls knapp:
#   AUTH_DATABASE_URL="postgresql://...?sslmode=require&connection_limit=3"
#
# =============================================================================
#  Service — public base URL (Angular + dev proxy)
# =============================================================================
#
#  PUBLIC_API_BASE_URL — Express base URL with no trailing slash (Swagger links, window.open).
#  Injected before `ng serve` / `npm run ui:build` (scripts/inject-ui-api-base.cjs).
#  Should match PORT / whatever URL the API is reachable on.
#
#  Local (backend usually PORT 3000, see below):
PUBLIC_API_BASE_URL=http://localhost:3000
#
#  Production: SPA and API on the same host — often leave empty; the UI then uses the
#  current browser origin. Split API host: e.g. https://api.example.com
# PUBLIC_API_BASE_URL=
#
# --- Node / HTTP (backend; usually set by npm scripts)
# NODE_ENV=development
# PORT=3000
#
# =============================================================================
#  Optional — external APIs and integrations (all optional for the dataDogs core)
# =============================================================================

# --- CORS (browser → API) — optional; local UI often works with defaults
# CORS_ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4200
# DEV_UI_ORIGIN=http://localhost:4300
# CORS_ORIGIN=https://your-domain.example

# Logging: Standard überall ruhig (keine großen Objekte / kein TRACK pro Zugriff).
# Diagnose: DATADOGS_LOG_LEVEL=verbose  oder  DATADOGS_VERBOSE=1
# Erzwingen leise: DATADOGS_LOG_LEVEL=quiet
# DATADOGS_LOG_LEVEL=quiet
#
# Optional: verbose Prisma logs (very chatty)
# DEBUG=prisma:query

# --- Anthropic Claude (optional)
# CLAUDE_API_KEY=
# CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# --- Philips Hue (optional)
# HUE_BRIDGE_HOST=
# HUE_BRIDGE_USER=
# HUE_INTER_COMMAND_DELAY_MS=120

# --- OpenRouteService (optional)
# ORS_API_KEYS=

# --- Overpass API — User-Agent sollte gesetzt sein; Rest optional
# OVERPASS_USER_AGENT=jsonAggregator/dev (Kontakt anpassen)
# OVERPASS_QUERY_TIMEOUT_SEC=25
# OVERPASS_FETCH_TIMEOUT_MS=30000
# Primaerer Overpass-Endpoint (TrailRetriever). Wenn leer: Default-Chain
# lz4 -> kumi -> public. Mehrere Mirror als Komma-Liste via OVERPASS_URLS.
# OVERPASS_URL=https://lz4.overpass-api.de/api/interpreter
# OVERPASS_URLS=https://lz4.overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# --- Windy / eBird (optional)
# WINDY_API_KEY=
# EBIRD_API_KEY=

# =============================================================================
#  Auth / MCP Gateway — Google SSO + OAuth Authorization Server
# =============================================================================
#
#  Aktiviert Google-Login (Browser-Flow) und exponiert /mcp + /actions für AI-Clients.
#  Für reines lokales Hacking ohne Login: MCP_AUTH_REQUIRED=false setzen — dann sind
#  alle Routes anonym, alle Kennels sichtbar, kein Google-Roundtrip nötig.
#
#  Setup:
#    1. https://console.cloud.google.com/  →  OAuth Client ID anlegen (Web application)
#    2. Authorized redirect URIs:
#         http://localhost:3000/auth/google/callback
#         https://<dein-render-host>/auth/google/callback
#    3. Client ID + Secret hier eintragen (Secret nur in .env, nicht .env.example).
#

# Google OAuth Client (von Google Cloud Console)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Basis-URL für die Konstruktion der redirect_uri. Lokal http://localhost:3000.
# Auf Render: https://datadogs-9qde.onrender.com (kein trailing slash).
# GOOGLE_OAUTH_REDIRECT_BASE=http://localhost:3000

# Öffentliche URL des Gateways — landet in OAuth-Discovery-Metadaten und Token-Issuer.
# MCP_BASE_URL=http://localhost:3000

# Master-Schalter. "false" = anonym, alles offen (Dev). "true" = Login + Visibility-Filter.
# MCP_AUTH_REQUIRED=false

# Signing-Key für ausgestellte JWTs (Access Tokens). Generieren:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_TOKEN_SIGNING_KEY=

# Cookie-Sessions für den Browser-Login-Flow. Random String, 32+ Zeichen.
# SESSION_SECRET=

# In Production "true" (HTTPS-only Cookies); lokal "false".
# SESSION_COOKIE_SECURE=false

# =============================================================================
#  SerializedDog VM execution (Worker-Sandbox)
# =============================================================================
#
#  Globaler Default-Timeout (Millisekunden) fuer jeden SerializedDog-Run im
#  Worker. Wird ueberschritten, terminate'd der Worker -- Server bleibt stehen,
#  Dog bekommt einen klaren Timeout-Error.
#
#  Per-Run-Override pro MCP-Call: `vmTimeoutMs` Argument an run_kennel /
#  execute_kennel / refresh_kennel_snapshot / build_kennel ueberschreibt
#  dieses Default fuer genau diesen Aufruf (nicht persistiert am Kennel).
#
#  Default: 10000 (10 Sekunden)
# DATADOGS_VM_TIMEOUT_MS=10000

# Pro-Identity MCP-Rate-Limit (Requests pro Minute). Welle 8 P3.
# DATADOGS_MCP_RATE_LIMIT=120
