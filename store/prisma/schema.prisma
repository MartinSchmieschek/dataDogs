// Prisma schema for jsonAggregator store — SQLite für lokale Entwicklung (NODE_ENV=development).
// PostgreSQL: schema.postgres.prisma (Integration/Production).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Dog {
  id                   String   @id          // GUID — the spirit's unique identity in this incarnation
  lineageId            String?               // GUID — binds all incarnations of the same spirit across branches
  parentId             String?               // GUID — the ancestor from which this incarnation was born (null fer the first)
  displayName          String?               // The spirit's true name — changeable without breaking the eldritch pacts
  type                 String
  // For SQLite we persist the serialized config as a string (JSON stored as text).
  // If you switch to Postgres you can change this field to `Json` for native JSONB support.
  serializedDogConfig   String?
  // Direkte Felder für KennelConfig (optional, da SerializedDogs diese nicht haben)
  name                 String?
  description          String?
  dogIds               String?  // Array als JSON-String (SQLite unterstützt kein Array)
  defaultQuery         String?  // JSON-String
  defaultBody          String?  // JSON-String
  emoji                String?  // Kennel-Icon (ein Emoji), optional
  task                 String?  // Kennel-Aufgaben-/Briefing-Text (markdown-fähig)
  nodes                String?  // JSON-String: [{ id, x?, y?, comment? }]
  edges                String?  // JSON-String: [{ fromId, toId, comment? }]
  visibility           String?  // Kennel-Visibility: "public" | "private". Null bei Nicht-Kennel-Dogs.
  // NOTE: vmTimeoutMs ist KEIN Persistenz-Feld -- gehoert per-run-call mitgegeben (Welle 12 Korrektur).
  // Sollte eine alte DB die Spalte noch fuehren, bleibt sie ungelesen liegen (kein Migrations-Schmerz).
  ownerId              String?  // FK auf User.id. Null = community-editable (legacy / system-owned).
  editors              String?  // Comma-separated User.id list — additional users with edit rights.
  viewers              String?  // Comma-separated User.id list — additional users with read rights on private entities.
  createdAt            DateTime? @default(now())
  updatedAt            DateTime?
}

// Auth + OAuth tables moved to store/prisma-auth/ (own DATABASE: AUTH_DATABASE_URL).
// Kennel.ownerId / Dog.editors / Dog.viewers stay here as plain User-ID strings —
// the FK is logical, not enforced at DB level (cross-DB).
